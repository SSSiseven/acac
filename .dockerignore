# Allow source, tests, build inputs and root project Markdown documents.
*
!Dockerfile
!.dockerignore
!requirements-container.txt
!*.md
!acac/
!acac/**
!analysis/
!analysis/**
!tests/
!tests/**
!configs/
!configs/**
!scripts/
!scripts/**

# Exclude generated files even inside included directories.
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.egg-info
**/*.egg-info/**
**/.pytest_cache
**/.pytest_cache/**
**/.venv
**/.venv/**
**/.env
**/.env.*
**/data
**/data/**
**/result
**/result/**
**/artifacts
**/artifacts/**
**/icml25_result
**/icml25_result/**
**/*.tar
**/*.pt
**/*.pth
**/*.pickle
**/*.pkl
**/*.log
